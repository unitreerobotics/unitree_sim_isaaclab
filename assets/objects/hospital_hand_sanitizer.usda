#usda 1.0
(
    defaultPrim = "HandSanitizer"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "HandSanitizer" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.18
    bool physics:rigidBodyEnabled = 1

    def Scope "Looks"
    {
        def Material "ClearBlue"
        {
            token outputs:surface.connect = </HandSanitizer/Looks/ClearBlue/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.10, 0.48, 0.78)
                float inputs:opacity = 1.0
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }
        def Material "White"
        {
            token outputs:surface.connect = </HandSanitizer/Looks/White/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.96, 0.98, 1.0)
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
        def Material "MedicalGreen"
        {
            token outputs:surface.connect = </HandSanitizer/Looks/MedicalGreen/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.04, 0.55, 0.38)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }
    }

    def Cube "Bottle"
    {
        rel material:binding = </HandSanitizer/Looks/ClearBlue>
        double size = 1
        double3 xformOp:scale = (0.07, 0.045, 0.14)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }
    # Dedicated, slightly thicker collision proxy.  Keeping collision separate
    # from the render mesh produces a solid parallel surface for the Dex1 jaws.
    def Cube "BottleCollision" (prepend apiSchemas = ["PhysicsCollisionAPI"])
    {
        token visibility = "invisible"
        double size = 1
        double3 xformOp:scale = (0.074, 0.050, 0.142)
        uniform token[] xformOpOrder = ["xformOp:scale"]
        bool physics:collisionEnabled = 1
    }
    def Cube "Label"
    {
        rel material:binding = </HandSanitizer/Looks/White>
        double size = 1
        double3 xformOp:scale = (0.052, 0.002, 0.055)
        double3 xformOp:translate = (0, -0.023, -0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "CrossVertical"
    {
        rel material:binding = </HandSanitizer/Looks/MedicalGreen>
        double size = 1
        double3 xformOp:scale = (0.010, 0.0025, 0.035)
        double3 xformOp:translate = (0, -0.026, -0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cube "CrossHorizontal"
    {
        rel material:binding = </HandSanitizer/Looks/MedicalGreen>
        double size = 1
        double3 xformOp:scale = (0.035, 0.0025, 0.010)
        double3 xformOp:translate = (0, -0.026, -0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    def Cylinder "PumpNeck" (prepend apiSchemas = ["PhysicsCollisionAPI"])
    {
        rel material:binding = </HandSanitizer/Looks/White>
        uniform token axis = "Z"
        double radius = 0.018
        double height = 0.030
        double3 xformOp:translate = (0, 0, 0.085)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:collisionEnabled = 1
    }
    def Cube "Pump"
    {
        rel material:binding = </HandSanitizer/Looks/White>
        double size = 1
        double3 xformOp:scale = (0.055, 0.018, 0.014)
        double3 xformOp:translate = (0.018, 0, 0.105)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
